# Settings for the readiness dashboard. Copy to .env and fill in (GETTING_STARTED.md). Never share .env.

# APS app (https://aps.autodesk.com/myapps). The callback URL must match the app exactly.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://localhost:8080/
APS_SCOPES=data:read
AUTODESK_FORMA_API_BASE_URL=https://developer.api.autodesk.com

# Forma account (hub) and project, without the "b." prefix.
# Project ID: from the project's browser address in Forma (projects/<id>). Hub ID: from py src\whoami.py or your account admin.
FORMA_HUB_ID=
FORMA_PROJECT_ID=
FORMA_PROJECT_NAME=

# Readiness rules (GETTING_STARTED.md, section 9)
MAX_DEPTH=2
ISSUE_DONE_STATUSES=closed
FORM_DONE_STATUSES=submitted

# How assets are grouped into systems: an asset custom attribute's display name, or "category". Run py src\survey.py to choose.
SYSTEM_ATTRIBUTE=System Classification

# Dashboard (docs/06). Links back to Forma; {projectId} and {id} are filled in. VERIFY by clicking.
FORMA_ISSUE_URL=https://acc.autodesk.com/build/issues/projects/{projectId}/issues?issueId={id}
FORMA_FORM_URL=https://acc.autodesk.com/build/forms/projects/{projectId}/forms/{id}
FORMA_ASSET_URL=https://acc.autodesk.com/build/assets/projects/{projectId}/assets?assetId={id}

# Live 3D viewer: comma-separated model lineage URNs. Empty = viewer off. Run py src\survey.py --models to choose.
VIEWER_MODELS=
