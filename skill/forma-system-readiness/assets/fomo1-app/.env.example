# ============================================================
# FOMO1 - environment settings (copy to .env and fill in)
# Keep .env on your machine only. Never upload it to a Claude
# Project, Teams, email or Git. Do not put comments on value lines.
# ============================================================

# --- APS custom integration (from aps.autodesk.com > My Apps) ---
APS_CLIENT_ID=your-client-id
APS_CLIENT_SECRET=your-client-secret
APS_CALLBACK_URL=http://localhost:8080/
AUTODESK_FORMA_API_BASE_URL=https://developer.api.autodesk.com

# Least privilege for phase 1 (read only). Add data:write only in phase 2.
APS_SCOPES=data:read user-profile:read

# --- Which Forma hub / project (run `python fomo1.py hubs` and `projects`) ---
FORMA_HUB_ID=b.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FORMA_PROJECT_ID=b.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Data region header for Issues (US, EMEA, AUS ...). Leave blank for US.
FORMA_REGION=

# --- How a "system" is defined (there is no public Systems API) ---
# custom_attribute = group assets by an asset custom attribute (e.g. "System")
# category         = group assets by asset category name
# asset_field      = group by a field of the asset record (see below)
# map_file         = a CSV (system_map.csv) with each asset and its system, e.g. exported from Forma; see system_map.example.csv
#                    After editing the CSV run: python fomo1.py regroup --open   (no Forma calls)
SYSTEM_GROUP_BY=custom_attribute
SYSTEM_ATTRIBUTE_NAME=System

# asset_field = group by a top-level field of the asset record that Forma returns (find it with: python fomo1.py probe)
#   e.g. SYSTEM_GROUP_BY=asset_field  SYSTEM_FIELD_NAME=systemId   (dots allowed: a.b)
#   If that field holds an ID, name it via a systems list endpoint found by `probe`:
#   SYSTEMS_ENDPOINT=/construction/<service>/v1/projects/{projectId}/systems
SYSTEM_FIELD_NAME=
SYSTEMS_ENDPOINT=

# --- Readiness rules ---
# Issues in these statuses do NOT block readiness
ISSUE_CLOSED_STATUSES=closed
# Issues in these statuses are shown as warnings but do not block
ISSUE_WARNING_STATUSES=draft
# Forms in these statuses block readiness (v2 + v1 names)
FORM_OPEN_STATUSES=inProgress,inReview,draft,in_review
# Optional: if set, an asset whose status label is not in this list blocks readiness
READY_ASSET_STATUSES=
# How many hops to follow from an asset (asset > document > issue = 2)
MAX_DEPTH=3
# Follow asset-to-asset links (child/parent equipment)
FOLLOW_ASSET_LINKS=true

# --- Relationship domains to pull (comma separated) ---
REL_DOMAINS=autodesk-bim360-asset,autodesk-bim360-issue,autodesk-bim360-documentmanagement,autodesk-bim360-checklist

# --- Deep links into Forma web UI (verify by opening one item and copying its URL) ---
LINK_ISSUE=https://acc.autodesk.com/build/issues/projects/{projectId}/issues?preview={id}
LINK_ASSET=https://acc.autodesk.com/build/assets/projects/{projectId}/assets?preview={id}
LINK_FORM=https://acc.autodesk.com/build/forms/projects/{projectId}/forms/{id}
LINK_DOCUMENT=https://acc.autodesk.com/docs/files/projects/{projectId}?entityId={id}

# --- Output ---
OUTPUT_DIR=output
TOKEN_FILE=.secrets/tokens.json
